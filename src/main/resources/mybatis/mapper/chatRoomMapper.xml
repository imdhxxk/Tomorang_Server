<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.hs.after.Tomorang.DAO.chatRoomDAO">

    <!-- Result Map -->
    <resultMap id="chatRoomResultMap" type="kr.hs.after.Tomorang.model.chatRoom">
        <id property="id" column="id"/>
        <result property="roomId" column="room_id"/>
        <result property="user1" column="user1"/>
        <result property="user2" column="user2"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 채팅방 저장 -->
    <insert id="insert" parameterType="kr.hs.after.Tomorang.model.chatRoom"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_rooms (room_id, user1, user2, created_at)
        VALUES (#{roomId}, #{user1}, #{user2},
        #{createdAt, jdbcType=TIMESTAMP})
    </insert>

    <!-- 채팅방 ID로 조회 -->
    <select id="findByRoomId" resultMap="chatRoomResultMap">
        SELECT id, room_id, user1, user2, created_at
        FROM chat_rooms
        WHERE room_id = #{roomId}
    </select>

    <!-- 두 사용자 간의 채팅방 찾기 (순서 무관) -->
    <select id="findByUsers" resultMap="chatRoomResultMap">
        SELECT id, room_id, user1, user2, created_at
        FROM chat_rooms
        WHERE (user1 = #{user1} AND user2 = #{user2})
        OR (user1 = #{user2} AND user2 = #{user1})
        LIMIT 1
    </select>

</mapper>
