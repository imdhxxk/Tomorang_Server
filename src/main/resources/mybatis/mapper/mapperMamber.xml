<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.hs.after.Tomorang.DAO.memberDAO">
    <insert id="insert" parameterType="kr.hs.after.Tomorang.DTO.memberDTO">
        insert into member(id, pw, role, email, interest, image, nickName, oneWord, langLv)
        values (#{id},#{pw},#{role},#{email}, #{interest}, #{image}, #{nickName}, #{oneWord}, #{langLv})
    </insert>

    <select id="profile" resultType="kr.hs.after.Tomorang.DTO.memberDTO">
        select id, role, email, interest, image, nickName, oneWord, langLv from member where id = #{id}
    </select>

    <select id="loginSelect" resultType="kr.hs.after.Tomorang.DTO.memberDTO">
        select * from member
    </select>

    <select id="findById" resultType="kr.hs.after.Tomorang.DTO.memberDTO">
        SELECT * FROM member WHERE id = #{id}
    </select>

    <select id="findByNickName" resultType="kr.hs.after.Tomorang.DTO.memberDTO">
        SELECT * FROM member WHERE nickName = #{nickName}
    </select>
</mapper>