# =============================================
# Tomorang 환경변수 설정 예시
# 이 파일을 복사해서 .env 로 저장 후 값을 채워주세요
# .env 파일은 절대 git에 올리지 마세요!
# =============================================

# 서버 포트 (Railway는 자동 설정됨)
PORT=8081

# ---- MySQL 데이터베이스 ----
DB_URL=jdbc:mysql://your-db-host:3306/Tomorang?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ---- AWS S3 ----
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_S3_BUCKET=tomorang-storage
AWS_REGION=ap-northeast-2

# ---- JWT ----
JWT_SECRET=최소_32자_이상의_랜덤_시크릿_키를_입력하세요

# ---- DeepL 번역 API ----
DEEPL_API_KEY=your_deepl_api_key
